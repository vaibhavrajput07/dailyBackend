# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored and is loaded automatically by Spring Boot on startup
# (see `spring.config.import` in application.yml). In production (Render, etc.)
# set these as real environment variables instead of shipping a .env file.

SERVER_PORT=8080

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=daily
DB_USERNAME=daily
DB_PASSWORD=change-me

# JWT signing secret - must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-byte-plus-secret
JWT_EXPIRATION_MS=2592000000

# Comma-separated list of allowed CORS origin patterns for the deployed frontend
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
